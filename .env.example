# ==============================================================================
# TigerGraph & Gemini: Olympic Agentic GraphRAG - Environment Configuration
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# Never commit your actual '.env' file containing real secrets to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TigerGraph Savanna Cloud / Enterprise Instance Settings
# ------------------------------------------------------------------------------
# The HTTPS URL of your TigerGraph Savanna cluster or local machine
# Format: https://<your-cluster-id>.i.tgcloud.io (Cloud) or https://localhost:9000 (Local)
TG_HOST=https://YOUR_CLUSTER_ID.i.tgcloud.io

# Target graph database name created on TigerGraph (Default: GraphRAG)
TG_GRAPHNAME=GraphRAG

# TigerGraph administrative or service username (Default: tigergraph)
TG_USERNAME=tigergraph

# TigerGraph cluster password
TG_PASSWORD=your_tigergraph_password_here

# (Optional) RESTPP Secret key generated in GraphStudio or GSQL console
# Used for automatic JWT token generation and authentication refresh
TG_SECRET=your_tigergraph_secret_here

# (Optional) Pre-generated JWT authorization token (if not using username/password or secret)
TG_TOKEN=

# ------------------------------------------------------------------------------
# 2. Google Gemini LLM API Configuration
# ------------------------------------------------------------------------------
# Google AI Studio Gemini API Key (Obtain from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. Application & Server Settings (Optional / Defaults provided in config)
# ------------------------------------------------------------------------------
# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# FastAPI Web Server Host & Port (Default: 0.0.0.0, 8000)
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit Server Port (Default: 8501)
STREAMLIT_PORT=8501
